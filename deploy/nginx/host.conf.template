# Nginx del HOST (Droplet). Plantilla: reemplaza ${DOMAIN} por tu dominio.
# Instalación:
#   sudo cp deploy/nginx/host.conf.template /etc/nginx/sites-available/escoltas.conf
#   sudo sed -i "s/\${DOMAIN}/tu-dominio.com/g" /etc/nginx/sites-available/escoltas.conf
#   sudo ln -s /etc/nginx/sites-available/escoltas.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Después: sudo certbot --nginx -d tu-dominio.com -d www.tu-dominio.com

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        # SSE (/api/stream): no almacenar en buffer.
        proxy_buffering off;
        proxy_cache off;
    }
}
