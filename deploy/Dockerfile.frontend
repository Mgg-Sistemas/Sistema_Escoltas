# Frontend del Sistema de Escoltas (build estático + Nginx)
# Construir desde la raíz del repositorio:
#   docker build -f deploy/Dockerfile.frontend \
#     --build-arg VITE_SUPABASE_URL=... \
#     --build-arg VITE_SUPABASE_ANON_KEY=... \
#     --build-arg VITE_API_URL=https://tu-dominio.com \
#     -t escoltas-web .

# ---------- etapa de construcción ----------
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund

COPY frontend/ ./
# `public/` vive en la raíz del repo; vite.config.js lo usa como publicDir.
COPY public/ /public/

# VITE_* se inyecta en el bundle durante el build
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------- etapa de servir ----------
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
